{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/README.md",
      "**/SETUP.md",
      "**/shared/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "site": "agent-team-hub",
    "rewrites": []
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
